{
  "name": "express5-valid",
  "version": "1.0.0",
  "description": "Validation library for Express 5",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nodemon --config scripts/nodemon.json",
    "build": "node scripts/build.js",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adibou/express5-valid.git"
  },
  "keywords": [
    "express",
    "express5",
    "validation",
    "middleware"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/adibou/express5-valid/issues"
  },
  "homepage": "https://github.com/adibou/express5-valid#readme",
  "peerDependencies": {
    "express": "^5.0.0"
  },
  "dependencies": {
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.8",
    "esbuild": "^0.27.2",
    "nodemon": "^3.1.11",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
